# ═══════════════════════════════════════════════════════════════════════════
#  NOVATRIX DIGITAL — ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to `.env` for local development. `.env` is gitignored.
#
#  ── THE ONE RULE ──────────────────────────────────────────────────────────
#  Vite inlines every VITE_* variable into the JavaScript bundle at build
#  time. Anything with that prefix is PUBLIC — visible to anyone who opens
#  DevTools on the deployed site.
#
#  So: VITE_* is for public values only. Secrets go in the block at the
#  bottom, which the app never reads. `npm run build` runs a guard that fails
#  the build if a secret ever picks up a VITE_ prefix.
# ═══════════════════════════════════════════════════════════════════════════


# ─── PUBLIC — safe in the browser bundle ──────────────────────────────────

# Supabase project URL and the anon (publishable) key. The anon key is
# designed to be public: every table is behind Row Level Security, so it can
# read nothing without a valid session.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical origin for this deployment. Used to build the absolute auth
# redirect URLs, so it must match Supabase → Authentication → URL
# Configuration. Ignored by `npm run dev`, which uses localhost so magic
# links come back to your machine.
VITE_APP_URL=https://finance.novatrixdigital.in

# Only for hosting under a subdirectory, e.g. /app/. Leave unset for root.
# VITE_BASE_PATH=/

VITE_APP_NAME=Novatrix Digital
VITE_DEFAULT_CURRENCY=INR


# ═══════════════════════════════════════════════════════════════════════════
#  SERVER SECRETS — never prefixed with VITE_, never read by the app
# ═══════════════════════════════════════════════════════════════════════════
#
#  These belong to the `send-reminders` Supabase Edge Function. They live
#  here only so `npm run secrets:push` can upload them in one step:
#
#      npm run secrets:push
#
#  which runs `supabase secrets set` for each. After that they live in
#  Supabase, and you can blank them here if you prefer.
#
#  A Resend key can send mail as your verified domain. Treat it like a
#  password: never commit it, never paste it into a support ticket, and
#  rotate it at https://resend.com/api-keys if it is ever exposed.
# ═══════════════════════════════════════════════════════════════════════════

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# The From address. The domain must be verified in Resend, or mail will bounce
# or land in spam. Use onboarding@resend.dev while testing.
RESEND_FROM=Novatrix Digital <reminders@novatrixdigital.in>

# Where the "Open Novatrix" button in each email points.
APP_URL=https://finance.novatrixdigital.in

# A long random string. Lets a scheduler call the function without holding the
# service-role key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMINDER_SECRET=

# Supabase project ref (the subdomain of your project URL) — used by the
# secrets:push script to target the right project.
SUPABASE_PROJECT_REF=your-project-ref

# ─── NEVER PUT THIS ANYWHERE ──────────────────────────────────────────────
# The Supabase service_role key bypasses Row Level Security entirely. It is
# injected into Edge Functions automatically — you never need to set it, and
# it must never appear in this file, in wrangler.toml, or under src/.
